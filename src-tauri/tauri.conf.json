{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QueryDeck",
  "version": "0.1.2",
  "identifier": "com.zilurane.querydeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QueryDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zilurrane/QueryDeck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNkVDNDQ2RTI4Q0QyNApSV1FrelNodVJPem1CSGd6WTlUY2x3UmRMc0FadGRkQWg0OEw2QTZ5UG82YzN2UFV6Sis1SldhNgo="
    }
  }
}
