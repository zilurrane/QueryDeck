{
  "name": "querydeck",
  "private": true,
  "version": "0.2.0",
  "description": "A fast, lightweight desktop SQL client for Microsoft SQL Server, PostgreSQL, MySQL, and SQLite — a slim, modern alternative to SSMS, Azure Data Studio, pgAdmin, and MySQL Workbench. Built with Tauri, React, and a Rust core (tiberius + sqlx).",
  "keywords": [
    "sql-client",
    "sql-server",
    "mssql",
    "postgresql",
    "postgres",
    "mysql",
    "mariadb",
    "sqlite",
    "database-client",
    "ssms-alternative",
    "pgadmin-alternative",
    "tauri",
    "sql-editor"
  ],
  "homepage": "https://github.com/zilurrane/QueryDeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zilurrane/QueryDeck.git"
  },
  "bugs": {
    "url": "https://github.com/zilurrane/QueryDeck/issues"
  },
  "author": "Zilu Ramkrishna Rane <zilurrane@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/codemirror-theme-github": "^4.25.10",
    "@uiw/codemirror-theme-vscode": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
